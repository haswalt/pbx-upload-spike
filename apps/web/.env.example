# ---- Azure Blob Storage -------------------------------------------------
# Storage account (name only) and private container for incoming uploads.
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER=incoming

# ---- Server identity (Entra ID) ------------------------------------------
# Used by DefaultAzureCredential to obtain a user delegation key.
# Locally you can leave these blank and run `az login` instead.
# On Vercel set them to a service principal that has
#   Storage Blob Delegator (account scope) + Storage Blob Data Contributor (container scope).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ---- Upload receipts -------------------------------------------------------
# HMAC key that signs the uploadId receipts. >= 32 chars.
#   openssl rand -base64 48
RECEIPT_SECRET=

# ---- Spike knobs -------------------------------------------------------------
# Enables diagnostics that need short TTL / small size overrides.
SPIKE_DEBUG_TOOLS=true
# There is no auth: this per-IP limit on upload URLs is the only brake.
SPIKE_ISSUE_RATE_PER_MINUTE=60
